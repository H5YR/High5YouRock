@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@* Community Engagement - Charts & Graphs *@
<section class="[ section -margin-top -margin-bottom ]">
  <div class="container">
    <div class="stats-dashboard">
      <h2 class="stats-dashboard__title">@Umbraco.GetDictionaryValue("CommunityStats.Title")</h2>

      <div class="stats-dashboard__charts">
        <div class="stats-chart">
          <h3 class="stats-chart__title">@Umbraco.GetDictionaryValue("CommunityStats.ActivityChart")</h3>
          <canvas id="js-activity-chart"></canvas>
        </div>
        <div class="stats-chart">
          <h3 class="stats-chart__title">@Umbraco.GetDictionaryValue("CommunityStats.ContributorsChart")</h3>
          <div id="js-contributors-chart" class="stats-contributors"></div>
        </div>
      </div>
    </div>
  </div>
</section>
