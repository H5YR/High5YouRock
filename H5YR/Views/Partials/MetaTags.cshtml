@using Umbraco.Cms.Web.Common.PublishedModels
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage


@* DNS prefetch and preconnect for external resources *@
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="preconnect" href="https://cdnjs.cloudflare.com">
<link rel="preconnect" href="https://www.googletagmanager.com">

@* Basic meta tags *@
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>@Model.Value("pageTitle", fallback: Fallback.ToAncestors)</title>
<meta name="description" content="Tell someone they rock with a simple friendly hashtag #h5yr" />

@* Open Graph / Facebook *@
<meta property="og:type" content="website" />
<meta property="og:url" content="https://h5yr.com" />
<meta property="og:title" content="High Five, You Rock! #h5yr" />
<meta property="og:description" content="Tell someone they rock with a simple friendly hashtag #h5yr" />
<meta property="og:image" content="https://h5yr.com/assets/images/h5yr.png" />

@* Dynamic Open Graph tags from Umbraco *@
<meta property="og:title" content="@Model.Value("websiteTitle", fallback: Fallback.ToAncestors)" />
<meta property="og:url" content="@Model.Url(mode: UrlMode.Absolute)" />

@* X (Twitter) *@
<meta property="og:site_name" content="High Five, You Rock! #h5yr" />
<meta name="twitter:site" content="@("@h5yr")" />
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content="https://h5yr.com" />
<meta property="twitter:title" content="High Five, You Rock! #h5yr" />
<meta property="twitter:description" content="Tell someone they rock with a simple friendly hashtag #h5yr" />
<meta property="twitter:image" content="https://h5yr.com/assets/images/h5yr.png" />
