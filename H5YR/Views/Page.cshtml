@using Umbraco.Cms.Web.Common.PublishedModels;
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<ContentModels.Page>
@using ContentModels = Umbraco.Cms.Web.Common.PublishedModels;
@{
    Layout = "Master.cshtml";
}


<section class="section section--top mb-2xl">
    <div class="container">
        <div class="content-block align-center">
            @if (Model.PageTitle != null)
            {
                <h1>@Model.PageTitle</h1>
            }
            @if (Model.BodyText != null)
            {
                @Model.BodyText
            }

        </div>
            @if (!Model.Script.IsNullOrWhiteSpace())
            {
                <div class="content-block align-center">
                        @Html.Raw(Model.Script)
                </div>
            }
      
    </div>

   
</section>