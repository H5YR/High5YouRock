@using Umbraco.Cms.Web.Common.PublishedModels
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>

    @await Html.PartialAsync("~/Views/Partials/MetaTags.cshtml")

    <environment exclude="Development">
        @*Global site tag (gtag.js) - Google Analytics*@
        <script async src="https://www.googletagmanager.com/gtag/js?id=UA-135183194-1"></script>
        <script>
            window.dataLayer = window.dataLayer || [];
            function gtag() { dataLayer.push(arguments); }
            gtag('js', new Date());
            gtag('config', 'UA-135183194-1');
        </script>
    </environment>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/bodymovin/5.5.2/lottie.min.js" integrity="sha256-G8zbnVrieJloV/OI6KCIpVKvP5uWGxqJ59/Z7w/MhAA=" crossorigin="anonymous"></script>

    <link href="https://fonts.googleapis.com/css?family=Montserrat:400,700,800&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer" />

    @* Vite assets - works in both dev and production *@
    <link rel="stylesheet" vite-href="~/app.js" />
    <script type="module" vite-src="~/app.js"></script>

</head>

<body class="template-@Model.ContentType.Alias node-@Model.Id" data-layout="">

    <environment exclude="Development">

    <noscript>
        <iframe src="https://www.googletagmanager.com/ns.html?id=GTM-PM6879J" height="0" width="0" style="display:none;visibility:hidden"></iframe>
    </noscript>

    </environment>


    <header class="@(Model is Page ? "header header-short" : "header")">
        <div class="container">
            <div class="header__inner">
                <div class="header__logo">
                    <a href="/">
                        <img src="/assets/images/logo.svg" alt="High Five, You Rock!" />
                    </a>
                </div>
                @await Html.PartialAsync("~/Views/Partials/Navigation.cshtml")
            </div>
        </div>
    </header>


    <main role="main">
        @RenderBody()
        @await Component.InvokeAsync("Sponsors")
    </main>
    

    <footer class="footer">
        <section class="footer__credits">
            <div class="container">    
                <img class="footer__logo" src="/assets/images/logo.svg" alt="High Five, You Rock!" />
                <p>Hosted on <a href="https://my.umbhost.net/aff.php?aff=1536" target="_blank" rel="noopener" class="footer__link">UmbHost</a>, built by the <a href="https://our.umbraco.com" target="_blank" rel="noopener" class="footer__link">Umbraco Community</a></p>
            </div>
        </section>
    </footer>
    
    </body>
</html>