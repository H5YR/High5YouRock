    <PackageVersion Include="System.IdentityModel.Tokens.Jwt" Version="8.14.0" />
    <PackageVersion Include="Skybrud.Social.Mastodon" Version="1.0.0-alpha005" />
    <PackageVersion Include="Umbraco.Cms" Version="17.3.5" />
    <PackageVersion Include="Umbraco.Cms.DevelopmentMode.Backoffice" Version="17.3.5" />
    <PackageVersion Include="Umbraco.Cms.Core" Version="17.3.5" />
    <PackageVersion Include="Umbraco.Cms.Infrastructure" Version="17.3.5" />
    <PackageVersion Include="Microsoft.ICU.ICU4C.Runtime" Version="72.1.0.3" />
    <PackageVersion Include="uSync" Version="17.3.1" />
    <PackageVersion Include="Vite.AspNetCore" Version="2.0.0" />
  </ItemGroup>
</Project>